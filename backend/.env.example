# 第一阶段只需下面三项即可启动。密钥留空，第三阶段接入 DeepSeek 时再填写。
APP_HOST=127.0.0.1
APP_PORT=8000
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# 相对路径会相对于 backend 目录。正式学习记录保存在这个文件中。
DATABASE_PATH=data/studymate.db

# 以下变量供后续阶段使用。不要把真实密钥写入代码或提交到 Git。
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat
DEEPSEEK_TIMEOUT=45
